{
  "name": "offline-stardew-valley-wiki",
  "productName": "Offline Stardew Valley Wiki",
  "version": "2.0.0",
  "description": "A multilingual offline desktop reader for the Stardew Valley Wiki",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "make:linux": "electron-forge make --platform=linux --arch=x64",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "prepare:edition": "node scripts/prepare-edition.mjs",
    "lint": "node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/renderer.js && node --check desktop/content-manager.js && node --check desktop/content-worker.js && node --check scripts/prepare-edition.mjs",
    "test:edition": "node scripts/test-prepare-edition.mjs",
    "test:content-installer": "node scripts/test-content-installer.mjs",
    "test:desktop-dependencies": "node scripts/test-desktop-dependencies.mjs",
    "test": "npm run lint && npm run test:desktop-dependencies && npm run test:edition && npm run test:content-installer",
    "content:pull": "bash scripts/pull-content.sh"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/packager": "^18.3.2",
    "electron": "43.3.0"
  },
  "keywords": [],
  "author": {
    "name": "Cristina Carrasco",
    "email": "cristina@cristinacarrasco.com"
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "electron-squirrel-startup": "1.0.1",
    "minisearch": "7.2.0",
    "tar": "7.5.22"
  }
}
